# =====================================================================
# Bazos Scraper & AI Evaluator - Konfigurace prostředí (.env)
# =====================================================================

# 1. Groq API konfigurace
# Získejte bezplatný API klíč na: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Podporované modely: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Telegram Bot konfigurace
# Vytvořte bota přes @BotFather na Telegramu
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Zjistěte své Chat ID např. přes @userinfobot na Telegramu
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Volné zadání uživatele (Co chcete koupit a za jakých podmínek)
USER_QUERY="Herní notebook s grafickou kartou RTX 3060 nebo lepší, minimálně 16 GB RAM, procesor AMD Ryzen nebo Intel i5/i7 (11. gen a novější), bez poškození a vad, cena do 18000 Kč"

# 4. Hrubý filtr cen (v Kč) - volitelné
MIN_PRICE=5000
MAX_PRICE=20000

# 5. Nastavení plánovače a filtrace
CHECK_INTERVAL_MINUTES=30
SCORE_THRESHOLD=8
MAX_PAGES_TO_SCRAPE=1

# 6. Režim simulace / Mock (nastavte na true pro otestování bez Groq API klíče)
MOCK_MODE=false

# 7. Systémová konfigurace
DATA_DIR=data
LOG_LEVEL=INFO
